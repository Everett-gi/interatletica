# =====================================================================
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# =====================================================================

# --- Dominio -----------------------------------------------------------
DOMINIO=interatletica.com.br
APP_URL_BASE=https://interatletica.com.br
EMAIL_ACME=contato@interatletica.com.br

# --- Banco -------------------------------------------------------------
POSTGRES_DB=interatletica
POSTGRES_USER=interatletica
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Google OAuth ------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizada:
#   https://interatletica.com.br/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Operadores da plataforma -----------------------------------------
# E-mails autorizados a CRIAR atleticas. Nao existe autocadastro: alguem
# precisa abrir a porta, e quem pode abrir fica explicito aqui.
#
# O operador NAO vira membro nem presidente de atlética nenhuma — ele cria
# a atletica e convida o primeiro presidente. Territorio comum.
#
# Separe por virgula. Deixar em branco significa que ninguem pode criar
# atletica: use isso depois que as atleticas fundadoras ja existirem.
APP_OPERADORES=

# --- Perfil ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# --- Backup (Cloudflare R2 via rclone) ---------------------------------
RCLONE_REMOTE=r2:interatletica-backups
BACKUP_RETENCAO_DIAS=30
