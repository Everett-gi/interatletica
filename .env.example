# =====================================================================
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# =====================================================================

# --- Dominio -----------------------------------------------------------
# Enquanto nao houver dominio proprio, o servidor usa
# interatletica.duckdns.org (DuckDNS, gratuito).
DOMINIO=interatletica.com.br
APP_URL_BASE=https://interatletica.com.br
# Nomes antigos que so redirecionam para o DOMINIO, separados por espaco
# - o provisorio de antes do dominio proprio, por exemplo. O www ja
# redireciona sozinho.
DOMINIOS_REDIRECIONADOS=

# --- Banco -------------------------------------------------------------
POSTGRES_DB=interatletica
POSTGRES_USER=interatletica
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Google OAuth ------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizada:
#   https://interatletica.com.br/login/oauth2/code/google
#
# Na demonstracao a API sobe mesmo sem credencial de verdade (qualquer
# texto nao vazio serve), porque a PWA demo nunca chama o login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Operadores da plataforma -----------------------------------------
# E-mails autorizados a CRIAR atleticas. Nao existe autocadastro: alguem
# precisa abrir a porta, e quem pode abrir fica explicito aqui.
#
# O operador NAO vira membro nem presidente de atlética nenhuma — ele cria
# a atletica e convida o primeiro presidente. Territorio comum.
#
# Separe por virgula. Deixar em branco significa que ninguem pode criar
# atletica: use isso depois que as atleticas fundadoras ja existirem.
APP_OPERADORES=

# --- Perfil ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# --- Backup (Cloudflare R2 via rclone) ---------------------------------
# Sem rclone configurado o backup fica so no disco do servidor.
RCLONE_REMOTE=r2:interatletica-backups
BACKUP_RETENCAO_DIAS=30

# --- So no servidor ----------------------------------------------------
# Liga infra/compose.producao.yml: imagens prontas do GHCR e memoria
# dimensionada para 1 GB. Fica comentado na maquina de desenvolvimento,
# onde o compose constroi as imagens a partir do codigo.
#
# COMPOSE_FILE=docker-compose.yml:infra/compose.producao.yml
# API_IMAGEM=ghcr.io/everett-gi/interatletica-api
#
# Uma das duas. A demo nao pede login e guarda tudo no navegador de quem
# usa; a outra fala com a API e exige o Google OAuth configurado acima.
# WEB_IMAGEM=ghcr.io/everett-gi/interatletica-web-demo
# WEB_IMAGEM=ghcr.io/everett-gi/interatletica-web
#
# Escrito pelo deploy.sh a cada implantacao. Nao edite a mao.
# IMAGEM_TAG=
